# Example environment variables for LMS backend
# Replace values with your real credentials before running
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
JWT_SECRET="replace-with-a-strong-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV="development"
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:5173"
# Optional: set to true to run seed data on container startup after migrations
# SEED_ON_STARTUP=true
